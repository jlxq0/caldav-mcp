CALDAV_MCP_RESOURCE_URL=https://caldav-mcp.your-domain.example
CALDAV_MCP_AUTHORIZATION_SERVER=https://login.your-domain.example/oidc
CALDAV_MCP_STALWART_DAV_BASE_URL=https://dav.your-domain.example
CALDAV_MCP_STALWART_AUDIENCE=https://caldav-mcp.your-domain.example
CALDAV_MCP_DCR_CLIENT_ID=replace-with-your-public-client-id
CALDAV_MCP_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,https://www.cursor.com/agents/mcp/oauth/callback,cursor://anysphere.cursor-mcp/oauth/callback,grokbot://mcp/oauth/callback,http://localhost:8787/callback,claude://claude.ai/oauth/callback,claude://oauth/callback,cowork://oauth/callback
CALDAV_MCP_BIND_ADDR=0.0.0.0:3000
CALDAV_MCP_LOG_FORMAT=json
RUST_LOG=caldav_mcp=info,tower_http=info,rmcp=warn

# Fresh MCP sessions one identity may open back to back, and the interval at
# which one slot refills once that burst is spent. Slots refill ONE AT A TIME,
# so recovering from empty takes burst x refill, not one refill.
# Defaults: 24 and 60.
CALDAV_MCP_INITIALIZE_BURST=24
CALDAV_MCP_INITIALIZE_REFILL_SECONDS=60
